{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "adguard-https",
        "server": "94.140.15.15",
        "server_port": 443,
        "path": "dns-query",
        "headers": {},
        "tls": {
          "enabled": true,
          "server_name": "dns.adguard-dns.com",
          "utls": {
            "enabled": true,
            "fingerprint": "random"
          }
        }
      }
    ]
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "in-full",
      "listen": "127.0.0.1",
      "listen_port": 1080
    },
    {
      "type": "socks",
      "tag": "in-warp",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "tag": "ws-direct",
      "type": "vless",
      "server": "{{ ansible_host }}",
      "server_port": 443,
      "uuid": "{{ client_uuid }}",
      "tls": {
        "enabled": true,
        "server_name": "{{ proxy_masked_vless_domain }}",
        "utls": {
          "enabled": true,
          "fingerprint": "random"
        }
      },
      "transport": {
        "type": "ws",
        "path": "{{ proxy_masked_singbox_vless_ws_path }}"
      }
    },
    {
      "tag": "ws-warp",
      "type": "vless",
      "server": "{{ ansible_host }}",
      "server_port": 443,
      "uuid": "{{ client_uuid }}",
      "tls": {
        "enabled": true,
        "server_name": "{{ proxy_masked_vless_domain }}",
        "utls": {
          "enabled": true,
          "fingerprint": "random"
        }
      },
      "transport": {
        "type": "ws",
        "path": "{{ proxy_masked_singbox_vless_ws_warp_path }}"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "in-warp"
        ],
        "outbound": "ws-warp"
      },
      {
        "inbound": [
          "in-full"
        ],
        "outbound": "ws-direct"
      },
      {
        "source_ip_is_private": true,
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "auto_detect_interface": true,
    "final": "ws-direct"
  }
}
